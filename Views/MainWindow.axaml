<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:CW_AvaloniaProject.Models"
        xmlns:local="using:CW_AvaloniaProject"
        x:Class="CW_AvaloniaProject.MainWindow"
        x:DataType="local:MainWindow"
        Title="Travel Agency Automation System"
        Width="1200" Height="700"
        MinWidth="1200" MinHeight="700">
        

    <Grid ColumnDefinitions="400, *" Margin="20">
        
        <!-- LEFT PANEL: INPUT FORM -->
        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,20,0">
            <StackPanel Spacing="10">
                <TextBlock Text="Create New Tour" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                
                <TextBlock Text="Tour Type:"/>
                <ComboBox x:Name="ComboType" SelectedIndex="0" HorizontalAlignment="Stretch">
                    <ComboBoxItem>International Tour</ComboBoxItem>
                    <ComboBoxItem>Domestic Tour</ComboBoxItem>
                </ComboBox>
                <TextBlock Text="Destination:"/>
                <TextBox x:Name="TxtDest" Watermark="Destination (e.g. Paris)" />

                <TextBlock Text="Start Date:"/>
                <TextBox x:Name="TxtDate" Watermark="Start Date (YYYY-MM-DD)" />

                <TextBlock Text="Duration:"/>
                <TextBox x:Name="TxtDuration" Watermark="Days as integer" />

                <TextBlock Text="Base Price ($):"/>
                <TextBox x:Name="TxtPrice" Watermark="1000, 100, 10 etc." />

                <StackPanel x:Name="PanelInternational" Spacing="10">
                    <TextBlock Text="Visa Cost ($):"/>
                    <TextBox x:Name="TxtVisa" Watermark="1000, 100, 10 etc." />
                    <TextBlock Text="Flight Insurance ($):"/>
                    <TextBox x:Name="TxtInsurance" Watermark="1000, 100, 10 etc." />
                </StackPanel>

                <StackPanel x:Name="PanelDomestic" Spacing="10" IsVisible="False">
                    <CheckBox x:Name="ChkTransport" Content="Include Private Transport (+$150)" />
                </StackPanel>

                <Button Content="Add Tour to System" Click="OnAddClick" HorizontalAlignment="Stretch" Background="#007ACC" Foreground="White" Margin="0,20,0,0"/>
                
                <!-- Status Message Area -->
                <TextBlock x:Name="StatusText" Foreground="Red" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- RIGHT PANEL: DASHBOARD -->
        <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto">

            <!-- DATABASE CONTROLS -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                <Button Content="Load from Database (SQL)" Click="OnLoadDbClick"/>
                <Button Content="Save to Database (SQL)" Click="OnSaveDbClick"/>
                <TextBlock x:Name="DbStatus" VerticalAlignment="Center" FontStyle="Italic"/>
            </StackPanel>

            <!-- LIST VIEW -->
            <ListBox x:Name="TourList" Grid.Row="1" BorderThickness="1" BorderBrush="LightGray">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:TravelPackage">
                        <StackPanel Margin="5">
                            <TextBlock Text="{Binding Destination}" FontWeight="Bold" FontSize="16"/>
                            <!-- Polymorphic description call -->
                            <TextBlock Text="{Binding DisplayDescription}" FontSize="12" Foreground="Gray"/>
                            <TextBlock Text="{Binding DisplayPrice}" Foreground="Green" FontWeight="Bold"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- LINQ CONTROLS -->
            <Border Grid.Row="2" Background="#F0F0F0" Padding="10" Margin="0,10,0,0" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="LINQ Operations" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBox x:Name="TxtSearch" Watermark="Search by destination..." />
                        <Button Grid.Column="1" Content="Search" Click="OnSearchClick" Margin="5,0,0,0"/>
                    </Grid>
                    <WrapPanel Orientation="Horizontal">
                        <Button Content="Show All" Click="OnShowAllClick" Margin="0,0,5,5"/>
                        <Button Content="Sort by Date" Click="OnSortDateClick" Margin="0,0,5,5"/>
                        <Button Content="Filter: Cheap Only (less than $1000)" Click="OnFilterCheapClick" Margin="0,0,5,5"/>
                        <Button Content="Only International" Click="OnFilterIntlClick" Margin="0,0,5,5"/>
                        <Button Content="Calculate Revenue" Click="OnRevenueClick" Margin="0,0,5,5"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>